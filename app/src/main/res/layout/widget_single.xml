<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView android:id="@+id/name" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Boa" android:textColor="#E98A60" android:textSize="14sp" android:textStyle="bold" />
    <TextView android:id="@+id/days" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:includeFontPadding="false" android:text="—" android:textColor="#FFFFFF"
        android:textSize="42sp" android:textStyle="bold" />
    <TextView android:id="@+id/sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:ellipsize="end" android:maxLines="2" android:text="dni do karmienia"
        android:textColor="#93A194" android:textSize="12sp" />
    <TextView android:id="@+id/feed" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:background="@drawable/bg_btn"
        android:paddingStart="12dp" android:paddingTop="6dp" android:paddingEnd="12dp" android:paddingBottom="6dp"
        android:text="✓ Nakarmiony" android:textColor="#0E1A0B" android:textSize="13sp" android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
